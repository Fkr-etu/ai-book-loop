# ==========================================
# Configuration locale & GCP
# ==========================================

# Backend — production secrets are injected by Secret Manager
GEMINI_API_KEY=votre_cle_gemini_api_ici
JWT_SECRET_KEY=votre_cle_secrete_jwt_super_securisee_32_caracteres_min

# PostgreSQL
# Local: postgresql://book_loop:book_loop@localhost:5432/book_loop
# GCP Cloud Run + Cloud SQL: use the Cloud SQL Unix socket form documented in
# docs/architecture/deployment-guide.md
DATABASE_URL=postgresql://book_loop:book_loop@localhost:5432/book_loop

# Auth / CORS
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
CORS_ORIGINS=http://localhost:3000

# Frontend
# Production is injected at build time by Cloud Build.
NEXT_PUBLIC_API_URL=http://localhost:8000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Local linguistic validation
LINGUISTIC_CHECKER=disabled
LANGUAGE_TOOL_URL=http://localhost:8010
LINGUISTIC_LANGUAGE=fr
SPACY_MODEL=fr_core_news_sm
MAX_RETRIES=3
REVIEW_THRESHOLD=7
