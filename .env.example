# ==========================================
# Configuration d'environnement Local & Déploiement Cloud
# ==========================================

# ------------------------------------------
# Backend Python (GCP Cloud Run / Supabase)
# ------------------------------------------

# Clé API Google Gemini (Inférence LLM)
GEMINI_API_KEY=votre_cle_gemini_api_ici

# Base de données PostgreSQL
# Local Docker :
#DATABASE_URL=postgresql://book_loop:book_loop@localhost:5432/book_loop
# Production Supabase PostgreSQL :
#DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Clé secrète pour les tokens JWT d'authentification
JWT_SECRET_KEY=votre_cle_secrete_jwt_super_securisee_32_caracteres_min

# Configuration Sécurité Cookies Cross-Domain (Vercel <-> Cloud Run)
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# Origines CORS autorisées (URL du Frontend Next.js sur Vercel)
CORS_ORIGINS=https://votre-app-manuscript-studio.vercel.app,http://localhost:3000

# ------------------------------------------
# Frontend Next.js (Vercel)
# ------------------------------------------

# URL de l'API Backend FastAPI déployée sur GCP Cloud Run
NEXT_PUBLIC_API_URL=https://book-loop-backend-xxx-ew.a.run.app
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

DATABASE_URL=postgresql://book_loop:book_loop@localhost:5432/book_loop
LINGUISTIC_CHECKER=disabled
LANGUAGE_TOOL_URL=http://localhost:8010
LINGUISTIC_LANGUAGE=fr
SPACY_MODEL=fr_core_news_sm
MAX_RETRIES=3
REVIEW_THRESHOLD=7
