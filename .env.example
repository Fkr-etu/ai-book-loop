# ==========================================
# Configuration d'environnement Local & GCP
# ==========================================

# ------------------------------------------
# Backend Python (GCP Cloud Run)
# ------------------------------------------

# Clé API Google Gemini (Inférence LLM)
GEMINI_API_KEY=votre_cle_gemini_api_ici

# Base de données PostgreSQL
# Local Docker :
# DATABASE_URL=postgresql://book_loop:book_loop@localhost:5432/book_loop
# Production : Cloud SQL PostgreSQL (injecté par le déploiement GCP)
DATABASE_URL=postgresql://book_loop:book_loop@localhost:5432/book_loop

# Clé secrète pour les tokens JWT d'authentification
JWT_SECRET_KEY=votre_cle_secrete_jwt_super_securisee_32_caracteres_min

# Cookie d'authentification sécurisé en production
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Origines CORS autorisées : URL publique du frontend Cloud Run + local
CORS_ORIGINS=https://book-loop-frontend-xxx-ew.a.run.app,http://localhost:3000

# ------------------------------------------
# Frontend Next.js (GCP Cloud Run)
# ------------------------------------------

# URL publique de l'API backend FastAPI sur Cloud Run
NEXT_PUBLIC_API_URL=https://book-loop-backend-xxx-ew.a.run.app
NEXT_PUBLIC_USE_REAL_API=false

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

LINGUISTIC_CHECKER=disabled
LANGUAGE_TOOL_URL=http://localhost:8010
LINGUISTIC_LANGUAGE=fr
SPACY_MODEL=fr_core_news_sm
MAX_RETRIES=3
REVIEW_THRESHOLD=7
